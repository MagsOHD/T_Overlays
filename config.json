{
  "streamer": {
    "name": "Votre Nom",
    "socials": {
      "twitch": "votre_twitch",
      "twitter": "votre_twitter",
      "youtube": "votre_youtube",
      "discord": "votre_discord"
    }
  },
  "theme": {
    "primaryColor": "#6441a5",
    "secondaryColor": "#9147ff",
    "accentColor": "#f1c40f",
