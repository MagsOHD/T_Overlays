    "subscription": {
      "enabled": true,
      "duration": 7000,
      "sound": "assets/sounds/sub.mp3",
      "volume": 0.8,
      "message": "{user} vient de s'abonner !"
    },
    "donation": {
      "enabled": true,
      "duration": 7000,
      "sound": "assets/sounds/donation.mp3",
      "volume": 0.8,
