# ==============================================
# Environment Configuration
# Esports Tournament Platform
# ==============================================

# ==============================================
# General
# ==============================================
NODE_ENV=development
APP_ENV=local
APP_DEBUG=true

# ==============================================
# Laravel API Configuration
# ==============================================
APP_NAME="Esports Tournament"
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=esports_tournament
DB_USERNAME=esports_user
DB_PASSWORD=esports_pass

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Cache & Sessions
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis

# Mail (configure selon votre provider)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@esports.local"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost
SESSION_DOMAIN=localhost

# ==============================================
# NestJS Real-time Configuration
# ==============================================
NESTJS_PORT=3001
NESTJS_HOST=0.0.0.0

# Database (same as Laravel)
NESTJS_DB_TYPE=postgres
NESTJS_DB_HOST=postgres
NESTJS_DB_PORT=5432
NESTJS_DB_USERNAME=esports_user
NESTJS_DB_PASSWORD=esports_pass
NESTJS_DB_DATABASE=esports_tournament

# Redis (same as Laravel)
NESTJS_REDIS_HOST=redis
NESTJS_REDIS_PORT=6379

# JWT Secret (for validating Laravel Sanctum tokens)
JWT_SECRET=your-jwt-secret-here-generate-random

# Laravel API URL (for internal communication)
LARAVEL_API_URL=http://laravel:8000

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN=*
WEBSOCKET_NAMESPACE=/

# ==============================================
# Frontend Configuration
# ==============================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:3001
REACT_APP_OVERLAYS_URL=http://localhost:3000/overlays

# ==============================================
# Database Tools
# ==============================================

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@esports.local
PGADMIN_DEFAULT_PASSWORD=admin

# Redis Commander
REDIS_COMMANDER_PORT=8081

# ==============================================
# Production Settings (override in .env.production)
# ==============================================

# Uncomment for production
# APP_ENV=production
# APP_DEBUG=false
# NODE_ENV=production

# Security
# SANCTUM_STATEFUL_DOMAINS=yourdomain.com
# SESSION_DOMAIN=.yourdomain.com

# Database Production (managed service recommended)
# DB_HOST=your-managed-postgres.cloud
# DB_PORT=5432
# DB_DATABASE=esports_prod
# DB_USERNAME=esports_prod_user
# DB_PASSWORD=STRONG_PASSWORD_HERE

# Redis Production (managed service recommended)
# REDIS_HOST=your-managed-redis.cloud
# REDIS_PASSWORD=STRONG_PASSWORD_HERE

# Mail Production (use a real service)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=YOUR_SENDGRID_API_KEY
# MAIL_ENCRYPTION=tls

# Logging & Monitoring
# LOG_CHANNEL=stack
# LOG_LEVEL=error
# SENTRY_DSN=your-sentry-dsn-here

# ==============================================
# Optional Features
# ==============================================

# File Storage (S3, etc.)
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# Broadcasting (for Laravel)
# BROADCAST_DRIVER=redis
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=

# Analytics
# GOOGLE_ANALYTICS_ID=
# MIXPANEL_TOKEN=

# ==============================================
# Notes
# ==============================================

# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Generate APP_KEY with: docker-compose exec laravel php artisan key:generate
# 4. For production, use strong passwords and secrets
# 5. Use managed services for PostgreSQL and Redis in production
